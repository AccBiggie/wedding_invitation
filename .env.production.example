# Modelo do .env de PRODUCAO. Na VPS: copie para /opt/wedding/.env e preencha.
# Nunca versione o .env de verdade.

# Dominio do site (sem https://) e e-mail para o certificado HTTPS (Let's Encrypt).
DOMAIN=seu-dominio.com.br
ACME_EMAIL=voce@exemplo.com

# Segredo dos logins do painel: gere com  openssl rand -base64 48  (minimo 32 caracteres).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin criado no primeiro start (o banco de producao comeca vazio). Use uma senha nova.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Usuario do MongoDB (o banco exige senha). Gere a senha com  openssl rand -hex 24  (sem simbolos, vai na URL).
MONGO_ROOT_USER=wedding
MONGO_ROOT_PASSWORD=

# Cloudflare R2 (imagens). Os mesmos valores do .env local, se for o mesmo bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
IMAGE_WEBP_QUALITY=80

# Copia externa dos backups do banco: um bucket do R2 so para backups (opcional; vazio = desligado).
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=
