# Caddy: HTTPS automatico (Let's Encrypt) para o dominio do site.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	reverse_proxy frontend:80
}

# Outros sites da VPS (ex.: Fetech). Cada projeto grava o seu arquivo em /opt/caddy-sites
# no proprio deploy e recarrega o Caddy; sem arquivos, o import e ignorado.
import /etc/caddy/sites/*.caddy
