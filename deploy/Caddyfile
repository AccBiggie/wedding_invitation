# Caddy: HTTPS automatico (Let's Encrypt) para o dominio do site.
{
	email {$ACME_EMAIL}
}

# Outros sites da VPS (ex.: Fetech). Cada projeto grava o seu arquivo em /opt/caddy-sites
# no proprio deploy e recarrega o Caddy; sem arquivos, o import e ignorado.
# Fica antes do site do wedding porque traz o snippet (suspensao), de 00-suspensao.caddy,
# usado abaixo. Nao importe esse arquivo de novo: o snippet ficaria declarado duas vezes.
# A ordem dos blocos de site nao muda o roteamento do Caddy.
import /etc/caddy/sites/*.caddy

{$DOMAIN} {
	# Bloqueio pelo painel do Fetech: com /srv/bloqueios/painel/hosts/<dominio>, responde 503
	# com a pagina de suspensao. Exige o 00-suspensao.caddy em /opt/caddy-sites.
	import suspensao
	# Log de acesso JSON, legivel (0644) para as estatisticas do painel do Fetech.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 10
			roll_uncompressed
			mode 0644
		}
		format json
	}
	encode zstd gzip
	header {
		# CSP: scripts so do site (o index.html nao tem script inline). Estilos precisam de
		# unsafe-inline (atributos style do React e <style> injetado pelo MUI) e das fontes do
		# Google. img-src aceita https: porque o painel permite cadastrar imagem por URL.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	reverse_proxy frontend:80
}
